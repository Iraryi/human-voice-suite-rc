# Upstream clones are a local working cache, never committed.
# The manifest records the pinned commit for each upstream instead.
.upstream-cache/

node_modules/
dist/
coverage/
*.tsbuildinfo

# Generated by `npm run upstream:check`. Reports are regenerated on demand.
UPSTREAM_UPDATE_REPORT.md

# Benchmark runs are large and reproducible; the committed artefacts are
# BENCHMARK_RESULTS.md, which names the run it was rendered from, and
# benchmarks/candidates/, which the preservation measurement depends on and which
# therefore has to be in the repository for the numbers to be reproducible.
benchmarks/runs/

# Editor / OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Local scratch
*.local
.env
.env.*
.tmp-*
_tmp*

# Learned voice profiles. This is the user's own writing, not the project's.
profiles/

# Fetched third-party text. No licence, no commit: measured locally, published as
# aggregate numbers only. See benchmarks/external/README.md.
.external-corpora/
